# ==============================================================================
# SculptorAI Environment Configuration
# ==============================================================================

# Supabase PostgreSQL & Auth Configuration
# Obtain from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Configuration (Server-Side Only)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Configurable Google Gemini Model Identifiers
# Defaults to gemini-1.5-flash if not specified.
GEMINI_MODEL_GENERATION=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash
GEMINI_MODEL_DEBUG=gemini-1.5-flash

# Application Base URL (Used for CORS and auth redirects; no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Demo Mode Toggle (true / false)
# When true or when Supabase keys are not yet configured, enables clearly labeled Demo Mode.
DEMO_MODE=false
