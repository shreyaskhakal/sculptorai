# ==============================================================================
# SculptorAI Environment Configuration
# ==============================================================================

# Supabase PostgreSQL, Realtime & Auth Configuration
# Obtain from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Client-Safe Public Key (Supports modern publishable key or legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Privileged Key (NEVER expose to browser client or NEXT_PUBLIC_*)
# Supports modern secret key or legacy service_role key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Configuration (Server-Side Only - NEVER expose to browser)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Centralized Model Router Identifiers (lib/ai/model-router.ts)
# Currently supported Google Gemini production models:
# gemini-2.0-flash: Fast multimodal reasoning, code generation, vision, debugging
# gemini-1.5-pro: Deep multi-step spatial reasoning and complex architectural planning
AI_FAST_MODEL=gemini-2.0-flash
AI_QUALITY_MODEL=gemini-1.5-pro

# Environment overrides for specific pipeline tasks:
GEMINI_MODEL_GENERATION=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-2.0-flash
GEMINI_MODEL_DEBUG=gemini-2.0-flash
GEMINI_MODEL_REASONING=gemini-1.5-pro

# Application Base URL (Used for CORS and auth redirects; no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Toggle (true / false)
# When true, explicitly enables zero-dependency local demo mode with in-memory sandbox.
# When false (or in production), demo tokens and headers are strictly rejected (HTTP 401) to prevent authentication bypass.
DEMO_MODE=false


