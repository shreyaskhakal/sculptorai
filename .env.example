# ==============================================================================
# SculptorAI Environment Configuration
# ==============================================================================

# Supabase PostgreSQL, Realtime & Auth Configuration
# Obtain from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Configuration (Server-Side Only)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Centralized Model Router Identifiers (lib/ai/model-router.ts)
# Defaults to gemini-1.5-flash and gemini-1.5-pro
AI_GENERATION_MODEL=gemini-1.5-flash
AI_REASONING_MODEL=gemini-1.5-pro
AI_VISION_MODEL=gemini-1.5-flash
AI_DEBUG_MODEL=gemini-1.5-flash
AI_SCENE_EDITOR_MODEL=gemini-1.5-flash

# Legacy Model overrides for backward compatibility
GEMINI_MODEL_GENERATION=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash
GEMINI_MODEL_DEBUG=gemini-1.5-flash

# Application Base URL (Used for CORS and auth redirects; no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Toggle (true / false)
# When true or when keys are unconfigured, enables safe local mock persistence and evaluation.
DEMO_MODE=false
